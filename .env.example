# ==============================================================================
# DocMorph Environment Configuration Template
# Copy to .env and customize for your environment (never commit .env to git)
# ==============================================================================

# Application Environment (development, staging, production, testing)
DOCMORPH_ENVIRONMENT=development
DOCMORPH_DEBUG=true

# Security & Secrets (Must be at least 32 characters in production)
DOCMORPH_SECRET_KEY=replace-with-a-very-strong-cryptographically-random-32char-secret-key
DOCMORPH_DEV_AUTH_MODE=true

# Database Connection (SQLite for local dev, PostgreSQL for production)
# SQLite: sqlite:///./docmorph.db
# PostgreSQL: postgresql://username:password@localhost:5432/docmorph
DOCMORPH_DATABASE_URL=sqlite:///./docmorph.db

# Storage Provider (local | s3)
DOCMORPH_STORAGE_BACKEND=local

# S3 / Cloudflare R2 Credentials (Only required if DOCMORPH_STORAGE_BACKEND=s3)
# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
DOCMORPH_S3_ENDPOINT_URL=
DOCMORPH_S3_BUCKET_NAME=docmorph-documents
DOCMORPH_S3_ACCESS_KEY_ID=
DOCMORPH_S3_SECRET_ACCESS_KEY=
DOCMORPH_S3_REGION=auto

# Rate Limiting Controls
DOCMORPH_RATE_LIMIT_ENABLED=true
DOCMORPH_RATE_LIMIT_AUTH_PER_MINUTE=15
DOCMORPH_RATE_LIMIT_UPLOAD_PER_MINUTE=30
DOCMORPH_RATE_LIMIT_API_PER_MINUTE=180

# CORS Whitelist (JSON array of trusted origins)
DOCMORPH_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

